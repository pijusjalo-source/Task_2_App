# Only needed to run locally against the cloud services (copy to .env, never commit .env).
# On Render these are set in the web service's Environment settings.
DATABASE_URL=postgresql://user:password@host/dbname
FINNHUB_API_KEY=your_finnhub_key
# S3-compatible file storage (Supabase Storage → Project Settings → Storage → S3 Connection)
S3_ENDPOINT=https://<project_ref>.storage.supabase.co/storage/v1/s3
S3_REGION=eu-central-1
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key
S3_BUCKET=mag7-files
# Protects the cron endpoint. The scheduler sends it as "Authorization: Bearer <value>".
CRON_SECRET=some-long-random-string
