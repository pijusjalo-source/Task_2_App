# Only needed to run locally against the cloud services.
# On Vercel: DATABASE_URL and BLOB_READ_WRITE_TOKEN are set automatically when you
# connect Neon and Blob; FINNHUB_API_KEY you add yourself in Settings → Environment Variables.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx
FINNHUB_API_KEY=your_finnhub_key
# Optional: protects the cron endpoint. Vercel sends it as "Authorization: Bearer <value>".
CRON_SECRET=some-long-random-string
